# 에듀넷에서 발급받은 인증키와 등록 도메인. 실제 값은 커밋하지 마세요.
EDUNET_API_KEY=
EDUNET_DOMAIN=

# 성취수준 베타: 검증된 운영 환경에서 명시적으로 활성화합니다.
# 서명키 생성: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# 생성한 값을 로컬 .env에만 저장하고 여러 서버 인스턴스에서 동일하게 사용합니다.
EDUNET_REFERENCE_SECRET=
EDUNET_ACHIEVEMENT_SEARCH_ENABLED=false
EDUNET_ACHIEVEMENT_PDF_READ_ENABLED=false
EDUNET_ACHIEVEMENT_HWP_READ_ENABLED=false
EDUNET_ACHIEVEMENT_HWPX_READ_ENABLED=false
EDUNET_ACHIEVEMENT_AUTO_ATTACHMENT_SELECTION_ENABLED=false
EDUNET_RESOURCE_READ_ENABLED=false
